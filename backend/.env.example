# Banco de dados (usar um usuário/schema Postgres dedicado a este app,
# nunca o mesmo usuário do outro site que já roda na VPS)
DATABASE_URL="postgresql://ppap_user:CHANGE_ME@localhost:5432/ppap_db?schema=public"

# Banco separado para rodar os testes automatizados (tests/setup.ts limpa
# as tabelas a cada teste — NUNCA aponte isso para o banco de produção/demo).
# Crie com: createdb ppap_db_test
TEST_DATABASE_URL="postgresql://ppap_user:CHANGE_ME@localhost:5432/ppap_db_test?schema=public"

# Autenticação
JWT_SECRET="CHANGE_ME_SUPER_SECRET_RANDOM_STRING"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3001
NODE_ENV=development

# CORS - origem permitida do frontend web
CORS_ORIGIN="http://localhost:5173"

# Upload de arquivos
UPLOADS_DIR="./uploads"
MAX_UPLOAD_MB=15
